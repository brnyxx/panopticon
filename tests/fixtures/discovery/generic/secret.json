{
  "mcpServers": {
    "generic-secret": {
      "command": "synthetic-generic-server",
      "args": ["--fixture", "secret"],
      "env": {
        "PANO_SYNTHETIC_API_TOKEN": "PANO_SYNTHETIC_TOKEN_ONLY",
        "PANO_SYNTHETIC_SECRET": "synthetic-secret-value"
      }
    }
  },
  "servers": {
    "generic-secret-servers-root": {
      "command": "synthetic-secret-server",
      "args": ["--fixture", "servers-secret"],
      "headers": {
        "Authorization": "Bearer PANO_SYNTHETIC_HEADER"
      }
    }
  }
}
