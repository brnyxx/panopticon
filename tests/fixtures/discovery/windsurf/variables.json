{
  "mcpServers": {
    "windsurf-variable-stdio": {
      "command": "${WINDSURF_FIXTURE_BIN}/mcp-server",
      "args": ["--workspace", "${WINDSURF_FIXTURE_WORKSPACE}"],
      "env": {
        "FIXTURE_TOKEN": "${WINDSURF_FIXTURE_TOKEN}"
      }
    },
    "windsurf-variable-remote": {
      "serverUrl": "${WINDSURF_FIXTURE_URL}",
      "headers": {
        "Authorization": "Bearer ${WINDSURF_FIXTURE_TOKEN}"
      }
    }
  }
}
