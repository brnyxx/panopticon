{
  "mcpServers": {
    "tokenized-synthetic": {
      "command": "node",
      "args": ["token-mcp.js"],
      "env": {
        "PANO_TEST_API_TOKEN": "PANO_SYNTHETIC_TOKEN_ONLY",
        "PANO_TEST_HEADER": "Bearer PANO_SYNTHETIC_HEADER"
      },
      "headers": {
        "Authorization": "Bearer PANO_SYNTHETIC_HEADER"
      }
    }
  }
}
