{
  "$defs": {
    "ClientName": {
      "enum": [
        "claude-desktop",
        "claude-code",
        "cursor",
        "vscode",
        "windsurf",
        "generic"
      ],
      "title": "ClientName",
      "type": "string"
    },
    "ConfigScope": {
      "enum": [
        "global",
        "project"
      ],
      "title": "ConfigScope",
      "type": "string"
    },
    "IdentityConfidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "IdentityConfidence",
      "type": "string"
    },
    "InstallationSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "title": "InstallationSource",
      "type": "object"
    },
    "PackageEcosystem": {
      "enum": [
        "npm",
        "pypi",
        "docker"
      ],
      "title": "PackageEcosystem",
      "type": "string"
    },
    "PackageIdentity": {
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "$ref": "#/$defs/PackageEcosystem"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "pinned": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pinned"
        },
        "resolved": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved"
        }
      },
      "required": [
        "ecosystem",
        "name",
        "pinned",
        "resolved"
      ],
      "title": "PackageIdentity",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "registry",
        "git",
        "local",
        "remote"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "Transport": {
      "enum": [
        "stdio",
        "http",
        "sse"
      ],
      "title": "Transport",
      "type": "string"
    }
  },
  "$id": "https://panopticon.dev/schemas/installed_server.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "args": {
      "items": {
        "type": "string"
      },
      "title": "Args",
      "type": "array"
    },
    "client": {
      "$ref": "#/$defs/ClientName"
    },
    "command": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Command"
    },
    "config_path": {
      "pattern": "^~(?:/[^/]+)*$",
      "title": "Config Path",
      "type": "string"
    },
    "config_pointer": {
      "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
      "title": "Config Pointer",
      "type": "string"
    },
    "disabled": {
      "title": "Disabled",
      "type": "boolean"
    },
    "env_keys": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Env Keys",
      "type": "array"
    },
    "headers_keys": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Headers Keys",
      "type": "array"
    },
    "identity_confidence": {
      "$ref": "#/$defs/IdentityConfidence"
    },
    "installation_id": {
      "pattern": "^inst_[0-9a-f]{16}$",
      "title": "Installation Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "package": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ConfigScope"
    },
    "server_id": {
      "pattern": "^(npm|pypi|github|docker|remote|local):.+$",
      "title": "Server Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/InstallationSource"
    },
    "transport": {
      "$ref": "#/$defs/Transport"
    },
    "url": {
      "anyOf": [
        {
          "format": "uri",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Url"
    },
    "wrapped": {
      "title": "Wrapped",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "server_id",
    "installation_id",
    "name",
    "client",
    "config_path",
    "config_pointer",
    "scope",
    "transport",
    "command",
    "args",
    "env_keys",
    "url",
    "headers_keys",
    "package",
    "source",
    "identity_confidence",
    "disabled",
    "wrapped"
  ],
  "title": "InstalledServer",
  "type": "object"
}
