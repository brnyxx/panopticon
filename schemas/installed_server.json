{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panopticon.dev/schemas/installed_server.json",
  "title": "InstalledServer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "server_id",
    "name",
    "client",
    "config_path",
    "scope",
    "transport",
    "identity_confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "server_id": {
      "type": "string",
      "pattern": "^(npm|pypi|github|docker|remote|local):.+"
    },
    "name": {
      "type": "string"
    },
    "client": {
      "enum": [
        "claude-desktop",
        "claude-code",
        "cursor",
        "vscode",
        "windsurf",
        "generic"
      ]
    },
    "config_path": {
      "type": "string",
      "pattern": "^(?!/(Users|home)/)"
    },
    "scope": {
      "enum": [
        "global",
        "project"
      ]
    },
    "transport": {
      "enum": [
        "stdio",
        "http",
        "sse"
      ]
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "headers_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "package": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "enum": [
            "npm",
            "pypi",
            "docker"
          ]
        },
        "name": {
          "type": "string"
        },
        "pinned": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "registry",
            "git",
            "local",
            "remote"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "identity_confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "wrapped": {
      "type": "boolean",
      "default": false
    }
  }
}
