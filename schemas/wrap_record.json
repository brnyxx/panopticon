  "$id": "https://panopticon.dev/schemas/wrap_record.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "installation_id": {
      "pattern": "^inst_[0-9a-f]{16}$",
      "title": "Installation Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "server_id": {
      "pattern": "^(npm|pypi|github|docker|remote|local):.+$",
      "title": "Server Id",
      "type": "string"
    },
    "span": {
      "$ref": "#/$defs/WrapSpan"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "ts",
    "server_id",
    "installation_id",
    "span",
    "events",
    "coverage"
  ],
  "title": "WrapRecord",
  "type": "object"
}
