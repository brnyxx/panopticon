        },
        "reason_code": {
          "enum": [
            "TIMEOUT",
            "DISCOVERY_FAILED"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "status": {
          "const": "INCOMPLETE",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason_code",
        "diagnostics"
