        "host": {
          "format": "hostname",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "title": "Host",
          "type": "string"
        },
        "kind": {
          "const": "net",
          "title": "Kind",
          "type": "string"
        },
        "op": {
          "enum": [
            "connect",
            "dns"
          ],
          "title": "Op",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
