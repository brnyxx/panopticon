    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "Event": {
      "description": "Persistence-boundary root for the exhaustive event union.",
      "discriminator": {
        "mapping": {
          "blocked": "#/$defs/BlockedEvent",
          "file": "#/$defs/FileEvent",
          "leak": "#/$defs/LeakEvent",
          "net": "#/$defs/NetEvent",
          "plaintext_http": "#/$defs/PlaintextHttpEvent",
          "proc": "#/$defs/ProcessEvent"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FileEvent"
        },
        {
          "$ref": "#/$defs/NetEvent"
        },
        {
          "$ref": "#/$defs/ProcessEvent"
        },
        {
          "$ref": "#/$defs/LeakEvent"
        },
        {
          "$ref": "#/$defs/BlockedEvent"
        },
        {
          "$ref": "#/$defs/PlaintextHttpEvent"
        }
      ],
      "title": "Event"
    },
    "FailedStage": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "reason_code": {
          "enum": [
            "STAGE_ERROR",
            "PROTOCOL_ERROR",
            "TRANSPORT_ERROR"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "status": {
          "const": "FAILED",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason_code",
        "diagnostics"
      ],
      "title": "FailedStage",
      "type": "object"
    },
    "FileEvent": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "decoy": {
          "title": "Decoy",
          "type": "boolean"
        },
        "decoy_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decoy Key"
        },
        "kind": {
          "const": "file",
          "title": "Kind",
          "type": "string"
        },
        "op": {
          "enum": [
            "read",
            "write",
            "stat",
            "exec",
            "create",
            "delete"
          ],
          "title": "Op",
          "type": "string"
        },
        "path": {
          "pattern": "^(?!.*\\\\)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!//)(?![A-Za-z]:)(?!/[Uu][Ss][Ee][Rr][Ss]/)(?!/[Hh][Oo][Mm][Ee]/)(?!/[Mm][Nn][Tt]/[A-Za-z]/[Uu][Ss][Ee][Rr][Ss]/).+",
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "op",
        "path",
        "decoy",
        "decoy_key",
        "count"
      ],
      "title": "FileEvent",
      "type": "object"
    },
    "IncompleteStage": {
      "additionalProperties": false,
      "properties": {
