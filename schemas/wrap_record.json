          "title": "Op",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "sink": {
          "minLength": 1,
          "title": "Sink",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "op",
        "decoy_key",
        "sink",
        "count"
      ],
      "title": "LeakEvent",
      "type": "object"
    },
    "NetEvent": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
