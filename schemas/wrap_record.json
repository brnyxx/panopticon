      "required": [
        "schema_version",
        "kind",
        "op",
        "host",
        "request_path",
        "decoy_keys",
        "count"
      ],
      "title": "PlaintextHttpEvent",
      "type": "object"
    },
    "ProcessEvent": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "kind": {
          "const": "proc",
          "title": "Kind",
          "type": "string"
        },
        "op": {
          "const": "exec",
          "title": "Op",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "op",
        "argv",
        "count"
      ],
      "title": "ProcessEvent",
      "type": "object"
