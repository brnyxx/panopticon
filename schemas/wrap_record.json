      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "span_id": {
          "pattern": "^.+:[0-9]+$",
          "title": "Span Id",
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "tool",
        "request_id",
        "duration_ms"
      ],
      "title": "WrapSpan",
      "type": "object"
