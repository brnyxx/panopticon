          ],
          "title": "Port"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "via": {
          "enum": [
            "proxy",
            "direct",
            "dns"
          ],
          "title": "Via",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "op",
        "host",
        "port",
        "via",
        "count"
      ],
      "title": "NetEvent",
      "type": "object"
    },
