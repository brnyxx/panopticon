          "type": "string"
        },
        "status": {
          "const": "COMPLETE",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason_code",
        "diagnostics"
      ],
      "title": "CompleteStage",
      "type": "object"
    },
