    "SkippedStage": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "reason_code": {
          "enum": [
            "SKIPPED_DESTRUCTIVE",
