        "host": {
          "format": "hostname",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "title": "Host",
          "type": "string"
        },
        "kind": {
          "const": "blocked",
          "title": "Kind",
          "type": "string"
        },
        "op": {
          "const": "connect",
          "title": "Op",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "op",
        "host",
        "port",
        "count"
      ],
      "title": "BlockedEvent",
      "type": "object"
    },
    "CompleteStage": {
      "additionalProperties": false,
