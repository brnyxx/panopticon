        "installation_id": {
          "pattern": "^inst_[0-9a-f]{16}$",
          "title": "Installation Id",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "installation_id",
        "key",
        "detail"
      ],
      "title": "DiffEntry",
      "type": "object"
    },
    "FindingChanges": {
      "additionalProperties": false,
      "properties": {
        "changed": {
          "items": {
            "$ref": "#/$defs/DiffEntry"
          },
          "title": "Changed",
          "type": "array"
        },
        "new": {
          "items": {
            "$ref": "#/$defs/DiffEntry"
          },
          "title": "New",
          "type": "array"
        },
        "resolved": {
          "items": {
            "$ref": "#/$defs/DiffEntry"
          },
          "title": "Resolved",
          "type": "array"
        },
        "unchanged": {
          "items": {
            "$ref": "#/$defs/DiffEntry"
          },
          "title": "Unchanged",
          "type": "array"
        },
        "unknown": {
          "items": {
            "$ref": "#/$defs/DiffEntry"
          },
          "title": "Unknown",
          "type": "array"
        }
      },
      "required": [
        "new",
        "changed",
        "unchanged",
        "resolved",
        "unknown"
      ],
      "title": "FindingChanges",
      "type": "object"
    }
  },
  "$id": "https://panopticon.dev/schemas/diff_result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "behavior": {
      "items": {
        "$ref": "#/$defs/DiffEntry"
      },
      "title": "Behavior",
      "type": "array"
    },
    "capability": {
      "items": {
        "$ref": "#/$defs/DiffEntry"
      },
      "title": "Capability",
      "type": "array"
    },
    "findings": {
      "$ref": "#/$defs/FindingChanges"
    },
    "inventory": {
      "items": {
        "$ref": "#/$defs/DiffEntry"
      },
      "title": "Inventory",
      "type": "array"
    },
    "meaningful": {
      "items": {
        "$ref": "#/$defs/DiffEntry"
      },
      "title": "Meaningful",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "since": {
      "minLength": 1,
      "title": "Since",
      "type": "string"
    },
    "until": {
      "minLength": 1,
      "title": "Until",
      "type": "string"
    }
