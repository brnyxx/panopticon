{
  "$defs": {
    "BlockedEvent": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "host": {
          "format": "hostname",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "title": "Host",
          "type": "string"
        },
        "kind": {
          "const": "blocked",
          "title": "Kind",
          "type": "string"
        },
        "op": {
          "const": "connect",
          "title": "Op",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "op",
        "host",
        "port",
        "count"
      ],
      "title": "BlockedEvent",
      "type": "object"
    },
    "CompleteStage": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "reason_code": {
          "enum": [
            "COMPLETED",
            "VERSION_SELECTED"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "status": {
          "const": "COMPLETE",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason_code",
        "diagnostics"
      ],
      "title": "CompleteStage",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "dns": {
          "discriminator": {
            "mapping": {
              "COMPLETE": "#/$defs/CompleteStage",
              "FAILED": "#/$defs/FailedStage",
              "INCOMPLETE": "#/$defs/IncompleteStage",
              "NOT_REQUESTED": "#/$defs/NotRequestedStage",
              "PARTIAL": "#/$defs/PartialStage",
              "SKIPPED": "#/$defs/SkippedStage",
              "UNSUPPORTED": "#/$defs/UnsupportedStage"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompleteStage"
            },
            {
              "$ref": "#/$defs/PartialStage"
            },
            {
              "$ref": "#/$defs/IncompleteStage"
            },
            {
              "$ref": "#/$defs/FailedStage"
            },
            {
              "$ref": "#/$defs/UnsupportedStage"
            },
            {
              "$ref": "#/$defs/SkippedStage"
            },
            {
              "$ref": "#/$defs/NotRequestedStage"
            }
          ],
          "title": "Dns"
        },
        "file": {
          "discriminator": {
            "mapping": {
              "COMPLETE": "#/$defs/CompleteStage",
              "FAILED": "#/$defs/FailedStage",
              "INCOMPLETE": "#/$defs/IncompleteStage",
              "NOT_REQUESTED": "#/$defs/NotRequestedStage",
              "PARTIAL": "#/$defs/PartialStage",
              "SKIPPED": "#/$defs/SkippedStage",
              "UNSUPPORTED": "#/$defs/UnsupportedStage"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompleteStage"
            },
            {
              "$ref": "#/$defs/PartialStage"
            },
            {
              "$ref": "#/$defs/IncompleteStage"
            },
            {
              "$ref": "#/$defs/FailedStage"
            },
            {
              "$ref": "#/$defs/UnsupportedStage"
            },
            {
              "$ref": "#/$defs/SkippedStage"
            },
            {
              "$ref": "#/$defs/NotRequestedStage"
            }
          ],
          "title": "File"
        },
        "net": {
          "discriminator": {
            "mapping": {
              "COMPLETE": "#/$defs/CompleteStage",
              "FAILED": "#/$defs/FailedStage",
              "INCOMPLETE": "#/$defs/IncompleteStage",
              "NOT_REQUESTED": "#/$defs/NotRequestedStage",
              "PARTIAL": "#/$defs/PartialStage",
              "SKIPPED": "#/$defs/SkippedStage",
              "UNSUPPORTED": "#/$defs/UnsupportedStage"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompleteStage"
            },
            {
              "$ref": "#/$defs/PartialStage"
            },
            {
              "$ref": "#/$defs/IncompleteStage"
            },
            {
              "$ref": "#/$defs/FailedStage"
            },
            {
              "$ref": "#/$defs/UnsupportedStage"
            },
            {
              "$ref": "#/$defs/SkippedStage"
            },
            {
              "$ref": "#/$defs/NotRequestedStage"
            }
          ],
          "title": "Net"
        },
        "process": {
          "discriminator": {
            "mapping": {
              "COMPLETE": "#/$defs/CompleteStage",
              "FAILED": "#/$defs/FailedStage",
              "INCOMPLETE": "#/$defs/IncompleteStage",
              "NOT_REQUESTED": "#/$defs/NotRequestedStage",
              "PARTIAL": "#/$defs/PartialStage",
              "SKIPPED": "#/$defs/SkippedStage",
              "UNSUPPORTED": "#/$defs/UnsupportedStage"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompleteStage"
            },
            {
              "$ref": "#/$defs/PartialStage"
            },
            {
              "$ref": "#/$defs/IncompleteStage"
            },
            {
              "$ref": "#/$defs/FailedStage"
            },
            {
              "$ref": "#/$defs/UnsupportedStage"
            },
            {
              "$ref": "#/$defs/SkippedStage"
            },
            {
              "$ref": "#/$defs/NotRequestedStage"
            }
          ],
          "title": "Process"
        },
        "proxy": {
          "discriminator": {
            "mapping": {
              "COMPLETE": "#/$defs/CompleteStage",
              "FAILED": "#/$defs/FailedStage",
              "INCOMPLETE": "#/$defs/IncompleteStage",
              "NOT_REQUESTED": "#/$defs/NotRequestedStage",
              "PARTIAL": "#/$defs/PartialStage",
              "SKIPPED": "#/$defs/SkippedStage",
              "UNSUPPORTED": "#/$defs/UnsupportedStage"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompleteStage"
            },
            {
              "$ref": "#/$defs/PartialStage"
            },
            {
              "$ref": "#/$defs/IncompleteStage"
            },
            {
              "$ref": "#/$defs/FailedStage"
            },
            {
              "$ref": "#/$defs/UnsupportedStage"
            },
            {
              "$ref": "#/$defs/SkippedStage"
            },
            {
              "$ref": "#/$defs/NotRequestedStage"
            }
          ],
          "title": "Proxy"
        },
        "snapshot": {
          "discriminator": {
            "mapping": {
              "COMPLETE": "#/$defs/CompleteStage",
              "FAILED": "#/$defs/FailedStage",
              "INCOMPLETE": "#/$defs/IncompleteStage",
              "NOT_REQUESTED": "#/$defs/NotRequestedStage",
              "PARTIAL": "#/$defs/PartialStage",
              "SKIPPED": "#/$defs/SkippedStage",
              "UNSUPPORTED": "#/$defs/UnsupportedStage"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompleteStage"
            },
            {
              "$ref": "#/$defs/PartialStage"
            },
            {
              "$ref": "#/$defs/IncompleteStage"
            },
            {
              "$ref": "#/$defs/FailedStage"
            },
            {
              "$ref": "#/$defs/UnsupportedStage"
            },
            {
              "$ref": "#/$defs/SkippedStage"
            },
            {
              "$ref": "#/$defs/NotRequestedStage"
            }
          ],
          "title": "Snapshot"
        },
        "stdio": {
          "discriminator": {
            "mapping": {
              "COMPLETE": "#/$defs/CompleteStage",
              "FAILED": "#/$defs/FailedStage",
              "INCOMPLETE": "#/$defs/IncompleteStage",
              "NOT_REQUESTED": "#/$defs/NotRequestedStage",
              "PARTIAL": "#/$defs/PartialStage",
              "SKIPPED": "#/$defs/SkippedStage",
              "UNSUPPORTED": "#/$defs/UnsupportedStage"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompleteStage"
            },
            {
              "$ref": "#/$defs/PartialStage"
            },
            {
              "$ref": "#/$defs/IncompleteStage"
            },
            {
              "$ref": "#/$defs/FailedStage"
            },
            {
              "$ref": "#/$defs/UnsupportedStage"
            },
            {
              "$ref": "#/$defs/SkippedStage"
            },
            {
              "$ref": "#/$defs/NotRequestedStage"
            }
          ],
          "title": "Stdio"
        }
      },
      "required": [
        "file",
        "net",
        "process",
        "dns",
        "proxy",
        "snapshot",
        "stdio"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Declared": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/DeclaredCapability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "completeness": {
          "$ref": "#/$defs/DeclaredCompleteness"
        },
        "env": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Env",
          "type": "array"
        },
        "hosts": {
          "items": {
            "format": "hostname",
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
            "type": "string"
          },
          "title": "Hosts",
          "type": "array"
        },
        "paths": {
          "items": {
            "pattern": "^(?!.*\\\\)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!//)(?![A-Za-z]:)(?!/[Uu][Ss][Ee][Rr][Ss]/)(?!/[Hh][Oo][Mm][Ee]/)(?!/[Mm][Nn][Tt]/[A-Za-z]/[Uu][Ss][Ee][Rr][Ss]/).+",
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "processes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Processes",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/DeclaredSource"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "hosts",
        "paths",
        "env",
        "processes",
        "capabilities",
        "sources",
        "completeness"
      ],
      "title": "Declared",
      "type": "object"
    },
    "DeclaredCapability": {
      "enum": [
        "read",
        "write",
        "destructive",
        "open_world"
      ],
      "title": "DeclaredCapability",
      "type": "string"
    },
    "DeclaredCompleteness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "NONE"
      ],
      "title": "DeclaredCompleteness",
      "type": "string"
    },
    "DeclaredSource": {
      "enum": [
        "self_decl",
        "registry",
        "tool_description",
        "readme",
        "manifest",
        "config"
      ],
      "title": "DeclaredSource",
      "type": "string"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DiscoveryReason": {
      "enum": [
        "MODERN_METADATA",
        "SERVER_DISCOVERY",
        "LEGACY_HANDSHAKE"
      ],
      "title": "DiscoveryReason",
      "type": "string"
    },
    "Event": {
      "description": "Persistence-boundary root for the exhaustive event union.",
      "discriminator": {
        "mapping": {
          "blocked": "#/$defs/BlockedEvent",
          "file": "#/$defs/FileEvent",
          "leak": "#/$defs/LeakEvent",
          "net": "#/$defs/NetEvent",
          "plaintext_http": "#/$defs/PlaintextHttpEvent",
          "proc": "#/$defs/ProcessEvent"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FileEvent"
        },
        {
          "$ref": "#/$defs/NetEvent"
        },
        {
          "$ref": "#/$defs/ProcessEvent"
        },
        {
          "$ref": "#/$defs/LeakEvent"
        },
        {
          "$ref": "#/$defs/BlockedEvent"
        },
        {
          "$ref": "#/$defs/PlaintextHttpEvent"
        }
      ],
      "title": "Event"
    },
    "EvidenceKind": {
      "enum": [
        "PATH",
        "HOST",
        "PROCESS",
        "DECOY",
        "CONFIG",
        "PROTOCOL"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "FailedStage": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "reason_code": {
          "enum": [
            "STAGE_ERROR",
            "PROTOCOL_ERROR",
            "TRANSPORT_ERROR"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "status": {
          "const": "FAILED",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason_code",
        "diagnostics"
      ],
      "title": "FailedStage",
      "type": "object"
    },
    "FallbackReason": {
      "enum": [
        "NONE",
        "VERSION_RETRY",
        "LEGACY_REQUIRED",
        "STREAMABLE_HTTP_UNAVAILABLE",
        "DEPRECATED_SSE"
      ],
      "title": "FallbackReason",
      "type": "string"
    },
    "FileEvent": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "decoy": {
          "title": "Decoy",
          "type": "boolean"
        },
        "decoy_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decoy Key"
        },
        "kind": {
          "const": "file",
          "title": "Kind",
          "type": "string"
        },
        "op": {
          "enum": [
            "read",
            "write",
            "stat",
            "exec",
            "create",
            "delete"
          ],
          "title": "Op",
          "type": "string"
        },
        "path": {
          "pattern": "^(?!.*\\\\)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!//)(?![A-Za-z]:)(?!/[Uu][Ss][Ee][Rr][Ss]/)(?!/[Hh][Oo][Mm][Ee]/)(?!/[Mm][Nn][Tt]/[A-Za-z]/[Uu][Ss][Ee][Rr][Ss]/).+",
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "op",
        "path",
        "decoy",
        "decoy_key",
        "count"
      ],
      "title": "FileEvent",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "declared_source": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Declared Source"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/FindingEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "fix_available": {
          "title": "Fix Available",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[0-9a-f]{16}$",
          "title": "Id",
          "type": "string"
        },
        "installation_id": {
          "pattern": "^inst_[0-9a-f]{16}$",
          "title": "Installation Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FindingKind"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_key": {
          "pattern": "^lk_[0-9a-f]{16}$",
          "title": "Logical Key",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^obs_[a-z0-9_-]+$",
          "title": "Observation Id",
          "type": "string"
        },
        "remediation_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Remediation Key"
        },
        "rule_id": {
          "pattern": "^(CFG|HIST|WATCH|FIX|SENT)-\\d{3}$",
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "server_id": {
          "pattern": "^(npm|pypi|github|docker|remote|local):.+$",
          "title": "Server Id",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindingSeverity"
            },
            {
              "type": "null"
            }
          ]
        },
        "span_ref": {
          "anyOf": [
            {
              "pattern": "^.+:[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Span Ref"
        },
        "suppressed_by": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Suppressed By"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "logical_key",
        "rule_id",
        "severity",
        "kind",
        "title",
        "evidence",
        "location",
        "server_id",
        "installation_id",
        "observation_id",
        "span_ref",
        "remediation_key",
        "fix_available",
        "declared_source",
        "first_seen",
        "suppressed_by"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "subject",
        "value"
      ],
      "title": "FindingEvidence",
      "type": "object"
    },
    "FindingKind": {
      "enum": [
        "confirmed",
        "review",
        "info"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "FindingSeverity": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "IncompleteStage": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "reason_code": {
          "enum": [
            "TIMEOUT",
            "DISCOVERY_FAILED"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "status": {
          "const": "INCOMPLETE",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason_code",
        "diagnostics"
      ],
      "title": "IncompleteStage",
      "type": "object"
    },
    "LeakEvent": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "decoy_key": {
          "minLength": 1,
          "title": "Decoy Key",
          "type": "string"
        },
        "kind": {
          "const": "leak",
          "title": "Kind",
          "type": "string"
        },
        "op": {
          "const": "expose",
          "title": "Op",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sink": {
          "minLength": 1,
          "title": "Sink",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "op",
        "decoy_key",
        "sink",
        "count"
      ],
      "title": "LeakEvent",
      "type": "object"
    },
    "LocalSandbox": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "runtime": {
          "enum": [
            "docker",
            "podman"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "tracer": {
          "minLength": 1,
          "title": "Tracer",
          "type": "string"
        }
      },
      "required": [
        "runtime",
        "image",
        "image_digest",
        "tracer"
      ],
      "title": "LocalSandbox",
      "type": "object"
    },
    "NetEvent": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "host": {
          "format": "hostname",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "title": "Host",
          "type": "string"
        },
        "kind": {
          "const": "net",
          "title": "Kind",
