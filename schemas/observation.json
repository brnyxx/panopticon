    },
    "observation_id": {
      "pattern": "^obs_[a-z0-9_-]+$",
      "title": "Observation Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "package_resolved": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Package Resolved"
    },
    "pano_version": {
      "minLength": 1,
      "title": "Pano Version",
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/ProtocolInfo"
    },
    "sandbox": {
      "discriminator": {
        "mapping": {
          "docker": "#/$defs/LocalSandbox",
          "podman": "#/$defs/LocalSandbox",
          "remote": "#/$defs/RemoteSandbox"
        },
        "propertyName": "runtime"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LocalSandbox"
        },
        {
          "$ref": "#/$defs/RemoteSandbox"
        }
      ],
      "title": "Sandbox"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "server_id": {
      "pattern": "^(npm|pypi|github|docker|remote|local):.+$",
      "title": "Server Id",
      "type": "string"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/Span"
      },
      "title": "Spans",
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/ObservationState"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolInfo"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "server_id",
    "installation_id",
    "observed_at",
    "pano_version",
    "sandbox",
    "package_resolved",
    "protocol",
    "tools",
    "spans",
    "declared",
    "findings",
    "state"
  ],
  "title": "Observation",
  "type": "object"
}
